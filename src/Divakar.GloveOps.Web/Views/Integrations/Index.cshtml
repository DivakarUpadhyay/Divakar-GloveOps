@model IReadOnlyList<IntegrationLogItem>
@{
    ViewData["Title"] = "Integrations";
    bool n8n = ViewBag.N8nConfigured;
    bool dify = ViewBag.DifyConfigured;
}

<h1 class="h3 mb-3">Integrations</h1>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between"><b>n8n</b><span class="badge @(n8n ? "text-bg-success" : "text-bg-secondary")">@(n8n ? "Configured" : "Not configured")</span></div>
            <div class="small text-muted mt-1">On final approval the app POSTs the request to the n8n webhook. n8n notifies the plant and calls back <code>/api/integrations/n8n-callback</code>.</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between"><b>Dify</b><span class="badge @(dify ? "text-bg-success" : "text-bg-secondary")">@(dify ? "Configured" : "Not configured")</span></div>
            <div class="small text-muted mt-1">"Ask AI" calls a Dify chat app (RAG over product spec sheets) through the server.</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <b>Automation 360 &amp; Power BI</b>
            <div class="small text-muted mt-1">The A360 bot enters requests through this UI; Power BI reads the <code>bi</code> schema. See the <code>automation360/</code> and <code>powerbi/</code> folders.</div>
        </div>
    </div>
</div>

<div class="card p-3">
    <h2 class="h6">Integration log</h2>
    <table class="table table-sm mb-0">
        <thead class="table-light"><tr><th>Time</th><th>Channel</th><th>Request</th><th>Status</th><th>Detail</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td class="small text-nowrap">@l.LoggedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@l.Channel</td>
                <td>@if (l.RequestId is not null) { <a asp-controller="SampleRequests" asp-action="Details" asp-route-id="@l.RequestId">@l.RequestNo</a> }</td>
                <td><span class="badge @StatusUi.Badge(l.Status)">@l.Status</span></td>
                <td class="small text-break">@l.Detail</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5" class="text-muted text-center py-3">No integration events yet. Approve a request to trigger one.</td></tr> }
        </tbody>
    </table>
</div>
