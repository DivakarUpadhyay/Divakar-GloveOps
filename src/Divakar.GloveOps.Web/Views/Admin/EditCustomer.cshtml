@model CustomerEntity
@{
    var isNew = Model.CustomerId == 0;
    ViewData["Title"] = isNew ? "New customer" : $"Edit {Model.Name}";
}

<partial name="_AdminTabs" />

<form method="post" asp-action="EditCustomer" class="card p-4" style="max-width:640px">
    <h2 class="h5">@ViewData["Title"]</h2>
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input type="hidden" asp-for="CustomerId" />
    @* concurrency token: base64 of the ROWVERSION the user loaded *@
    <input type="hidden" asp-for="RowVer" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" maxlength="150" required />
    </div>
    <div class="mb-3">
        <label asp-for="Country" class="form-label">Country</label>
        <input asp-for="Country" class="form-control" maxlength="50" required />
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" id="btn-save">Save</button>
        <a asp-action="Customers" class="btn btn-link">Cancel</a>
    </div>
</form>

@if (!isNew)
{
    <form method="post" asp-action="DeleteCustomer" class="mt-3" onsubmit="return confirm('Delete this customer?');">
        <input type="hidden" name="id" value="@Model.CustomerId" />
        <input type="hidden" name="rowVer" value="@Convert.ToBase64String(Model.RowVer)" />
        <button class="btn btn-sm btn-outline-danger" id="btn-delete">Delete customer</button>
    </form>
}
