@model ProductEntity
@{
    var isNew = Model.ProductId == 0;
    ViewData["Title"] = isNew ? "New product" : $"Edit {Model.Sku}";
    List<PlantEntity> plants = ViewBag.Plants;
}

<partial name="_AdminTabs" />

<form method="post" asp-action="EditProduct" class="card p-4" style="max-width:720px">
    <h2 class="h5">@ViewData["Title"]</h2>
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input type="hidden" asp-for="ProductId" />
    <input type="hidden" asp-for="RowVer" />
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Sku" class="form-label">SKU</label>
            <input asp-for="Sku" class="form-control text-uppercase" maxlength="30" required />
        </div>
        <div class="col-md-8">
            <label asp-for="Name" class="form-label">Name</label>
            <input asp-for="Name" class="form-control" maxlength="150" required />
        </div>
        <div class="col-md-4">
            <label asp-for="Material" class="form-label">Material</label>
            <select asp-for="Material" class="form-select">
                @foreach (var m in Materials.All)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Category" class="form-label">Category</label>
            <input asp-for="Category" class="form-control" maxlength="50" list="categories" required />
            <datalist id="categories">
                <option value="Medical"></option>
                <option value="Food"></option>
                <option value="Cleanroom"></option>
                <option value="Industrial"></option>
            </datalist>
        </div>
        <div class="col-md-4">
            <label asp-for="PlantId" class="form-label">Producing plant</label>
            <select asp-for="PlantId" class="form-select">
                <option value="0">— select —</option>
                @foreach (var p in plants)
                {
                    <option value="@p.PlantId">@p.Name (@p.Country)</option>
                }
            </select>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary" id="btn-save">Save</button>
        <a asp-action="Products" class="btn btn-link">Cancel</a>
    </div>
</form>

@if (!isNew)
{
    <form method="post" asp-action="DeleteProduct" class="mt-3" onsubmit="return confirm('Delete this product?');">
        <input type="hidden" name="id" value="@Model.ProductId" />
        <input type="hidden" name="rowVer" value="@Convert.ToBase64String(Model.RowVer)" />
        <button class="btn btn-sm btn-outline-danger" id="btn-delete">Delete product</button>
    </form>
}
